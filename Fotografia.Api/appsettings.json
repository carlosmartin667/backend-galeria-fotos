{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=FotografiaDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Jwt": {
    "Issuer": "Fotografia.Api",
    "Audience": "Fotografia.Angular",
    "SigningKey": "__SET_WITH_USER_SECRETS_OR_ENV_MIN_32_CHARS__",
    "ExpirationMinutes": 120
  },
  "MercadoPago": {
    "AccessToken": "__SET_WITH_USER_SECRETS_OR_ENV__",
    "PublicKey": "__SET_WITH_USER_SECRETS_OR_ENV__",
    "WebhookSecret": "__SET_WITH_USER_SECRETS_OR_ENV__",
    "SuccessUrl": "http://localhost:4200/pagos/success",
    "FailureUrl": "http://localhost:4200/pagos/failure",
    "PendingUrl": "http://localhost:4200/pagos/pending",
    "NotificationUrl": "https://api.example.com/api/pagos/webhooks/mercado-pago"
  },
  "Resend": {
    "ApiKey": "__SET_WITH_USER_SECRETS_OR_ENV__",
    "FromEmail": "no-reply@example.com",
    "FromName": "Fotografia"
  },
  "CloudflareR2": {
    "AccountId": "__SET_WITH_USER_SECRETS_OR_ENV__",
    "AccessKeyId": "__SET_WITH_USER_SECRETS_OR_ENV__",
    "SecretAccessKey": "__SET_WITH_USER_SECRETS_OR_ENV__",
    "BucketName": "fotografia-fotos",
    "EndpointUrl": "https://__ACCOUNT_ID__.r2.cloudflarestorage.com",
    "PublicBaseUrl": "",
    "SignedUrlExpirationMinutes": 15
  },
  "AllowedHosts": "*"
}
